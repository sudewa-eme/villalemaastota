# Absolute site URL used for canonical and social metadata.
NEXT_PUBLIC_SITE_URL=https://www.lemaastota.com

# Optional: deep link into the property's booking engine. When set, the
# "Check availability" form redirects here with the guest's selection.
# Supported tokens: {checkin} {checkout} {adults} {children} (dates are YYYY-MM-DD).
# When unset, the form opens a pre-filled reservation request email instead.
NEXT_PUBLIC_BOOKING_URL_TEMPLATE=
